# ===== OKX API (留空则运行在纯公开行情模式) =====
# 在 OKX 官网「API 管理」创建，只勾选【读取】权限，切勿勾选交易/提币
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 1 = 模拟盘 (demo trading)，0 = 实盘
OKX_TRADING_ENABLED=0
# ↑ 交易总开关：0 = 只读观测（默认），1 = 允许下单（市价买/卖）
OKX_SIMULATED=1

# ===== Watchlist (逗号分隔) =====
SPOT_INSTRUMENTS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,DOGE-USDT,ADA-USDT,AVAX-USDT
SWAP_INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP,BNB-USDT-SWAP,XRP-USDT-SWAP,DOGE-USDT-SWAP,ADA-USDT-SWAP,AVAX-USDT-SWAP
DEFAULT_CHART_INST=BTC-USDT
CHART_TIMEFRAMES=1m,5m,15m,1H,4H,1D,1W,1M

# ===== 告警阈值 =====
ALERT_PRICE_CHANGE_PCT=2.0     # N 分钟内涨跌幅超过该值 (%) 时告警
ALERT_PRICE_WINDOW_S=300       # 观察窗口 (秒)
ALERT_FUNDING_PCT=0.1          # 资金费率绝对值阈值 (%)
ALERT_COOLDOWN_S=600           # 同一告警的冷却时间 (秒)

# ===== Telegram 推送 (留空则不推送) =====
# 向 @BotFather 创建 bot 拿到 token；chat_id 可向 @userinfobot 查询
TG_BOT_TOKEN=
TG_CHAT_ID=

# ===== 服务 =====
HOST=127.0.0.1
PORT=8765
DB_PATH=astrolabe.db
