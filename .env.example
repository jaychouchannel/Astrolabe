# ===== OKX API (留空则运行在纯公开行情模式) =====
# 在 OKX 官网「API 管理」创建，只勾选【读取】权限，切勿勾选交易/提币
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 1 = 模拟盘 (demo trading)，0 = 实盘
OKX_SIMULATED=1

# ===== Watchlist (逗号分隔) =====
SPOT_INSTRUMENTS=BTC-USDT,ETH-USDT,SOL-USDT
SWAP_INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP
DEFAULT_CHART_INST=BTC-USDT
CHART_TIMEFRAMES=1m,5m,15m,1H,4H,1D,1W,1M

# ===== 告警阈值 =====
ALERT_PRICE_CHANGE_PCT=2.0     # N 分钟内涨跌幅超过该值 (%) 时告警
ALERT_PRICE_WINDOW_S=300       # 观察窗口 (秒)
ALERT_FUNDING_PCT=0.1          # 资金费率绝对值阈值 (%)
ALERT_COOLDOWN_S=600           # 同一告警的冷却时间 (秒)

# ===== Telegram 推送 (留空则不推送) =====
# 向 @BotFather 创建 bot 拿到 token；chat_id 可向 @userinfobot 查询
TG_BOT_TOKEN=
TG_CHAT_ID=

# ===== 自动交易策略 (观星执行, 默认全关) =====
# 三道闸门全部打开才会真的下单; OKX_SIMULATED=1 时走模拟盘
OKX_TRADING_ENABLED=0     # okx_client 下单能力总闸
STRATEGY_ENABLED=0        # 策略后台循环开关
STRATEGY_ALLOW_LIVE=0     # 实盘许可 (仅 OKX_SIMULATED=0 时检查, 默认禁止策略碰实盘)
STRATEGY_INST=BTC-USDT-SWAP
STRATEGY_BAR=1m
STRATEGY_SIZE_USDT=100    # 每笔保证金预算 (USDT); 名义预算 = 保证金 x 杠杆
STRATEGY_LEVER=3          # 隔离杠杆; BTC 一张合约名义约 price*0.01 USDT, 请确保名义预算 >= 一张
STRATEGY_POLL_S=60        # 信号轮询间隔 (秒)
STRATEGY_COOLDOWN_S=300   # 成交后的冷却时间 (秒)

# ===== 服务 =====
HOST=127.0.0.1
PORT=8765
DB_PATH=astrolabe.db
